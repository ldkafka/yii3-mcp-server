{
    "name": "ldkafka/yii3-mcp-server",
    "type": "library",
    "description": "Model Context Protocol (MCP) server framework for Yii3 applications - expose custom tools to AI assistants over stdio or Streamable HTTP",
    "keywords": [
        "yii",
        "yii3",
        "mcp",
        "model-context-protocol",
        "ai",
        "github-copilot",
        "claude",
        "tool-server",
        "json-rpc",
        "stdio",
        "http",
        "streamable-http",
        "psr-15"
    ],
    "homepage": "https://github.com/ldkafka/yii3-mcp-server",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/ldkafka/yii3-mcp-server/issues",
        "source": "https://github.com/ldkafka/yii3-mcp-server",
        "docs": "https://github.com/ldkafka/yii3-mcp-server/blob/main/README.md"
    },
    "authors": [
        {
            "name": "ldkafka",
            "homepage": "https://github.com/ldkafka"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/console": "^6.0 || ^7.0 || ^8.0",
        "yiisoft/yii-console": "^2.0"
    },
    "require-dev": {
        "httpsoft/http-message": "^1.1",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "vimeo/psalm": "^5.26.1 || ^6.14.2"
    },
    "suggest": {
        "yiisoft/db": "Required for database query tools (MysqlQueryTool example)",
        "yiisoft/db-mysql": "Required for MySQL database tools",
        "yiisoft/cache-file": "Required for database schema caching",
        "yiisoft/router": "Required to route the HTTP transport (McpHttpHandler) in a Yii3 web application",
        "httpsoft/http-message": "PSR-7/PSR-17 implementation used by the HTTP transport in yiisoft/app based projects",
        "vlucas/phpdotenv": "Recommended for environment variable management"
    },
    "autoload": {
        "psr-4": {
            "YiiMcp\\McpServer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YiiMcp\\McpServer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.3.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
